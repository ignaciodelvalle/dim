{
  "$schema": "https://biomejs.dev/schemas/1.9.0/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "ignore": [
      ".next",
      "node_modules",
      "dist",
      "out",
      "supabase/.temp",
      "supabase/.branches",
      "docs/design/handoffs/**"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "a11y": {
        "recommended": true,
        "noBlankTarget": "error",
        "noLabelWithoutControl": "error",
        "noNoninteractiveTabindex": "error",
        "noPositiveTabindex": "error",
        "useAltText": "error",
        "useAriaPropsForRole": "error",
        "useButtonType": "error",
        "useFocusableInteractive": "error",
        "useHtmlLang": "error",
        "useIframeTitle": "error",
        "useKeyWithClickEvents": "error",
        "useSemanticElements": "error",
        "useValidAriaProps": "error",
        "useValidAriaValues": "error",
        "useValidLang": "error"
      },
      "complexity": {
        "noExcessiveCognitiveComplexity": {
          "level": "error",
          "options": {
            "maxAllowedComplexity": 25
          }
        }
      },
      "correctness": {
        "noUnusedVariables": "error",
        "noUnusedImports": "error"
      }
    }
  },
  "overrides": [
    {
      "include": ["src/modules/*/domain/**"],
      "linter": {
        "rules": {
          "nursery": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "@/db": "Domain layer must not import @/db. Use the repository interface injected by the application layer.",
                  "drizzle-orm": "Domain layer must not import drizzle-orm. Database access belongs in infrastructure.",
                  "next": "Domain layer must not import next. Framework dependencies belong in the actions layer.",
                  "next/cache": "Domain layer must not import next/cache. Framework dependencies belong in the actions layer.",
                  "next/navigation": "Domain layer must not import next/navigation. Framework dependencies belong in the actions layer.",
                  "next/headers": "Domain layer must not import next/headers. Framework dependencies belong in the actions layer.",
                  "server-only": "Domain layer must not import server-only. This marker belongs in infrastructure or actions."
                }
              }
            }
          }
        }
      }
    },
    {
      "include": ["src/modules/*/application/**"],
      "linter": {
        "rules": {
          "nursery": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "next": "Application layer must not import next. Framework dependencies belong in the actions layer (ADR 2026-07-18 native-readiness, Decision 1).",
                  "next/cache": "Application layer must not import next/cache. Revalidation belongs in the actions layer (ADR 2026-07-18 native-readiness, Decision 1).",
                  "next/navigation": "Application layer must not import next/navigation. Redirects belong in the actions layer (ADR 2026-07-18 native-readiness, Decision 1).",
                  "next/headers": "Application layer must not import next/headers. Request context belongs in the actions layer (ADR 2026-07-18 native-readiness, Decision 1).",
                  "server-only": "Application layer must not import server-only. This marker belongs in infrastructure or actions (ADR 2026-07-18 native-readiness, Decision 1)."
                }
              }
            }
          }
        }
      }
    },
