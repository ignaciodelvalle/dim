{
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true
  },
  "permissions": {
    "allow": [
      "Bash(pnpm verify)",
      "Bash(pnpm verify:mobile)",
      "Bash(pnpm test:verified)",
      "Bash(pnpm lint)",
      "Bash(pnpm lint:*)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm canon:render)",
      "Bash(npx tsc *)",
      "Bash(npx biome check *)",
      "Bash(pnpm biome check *)",
      "Bash(npx eas-cli@latest whoami)",
      "Bash(npx eas-cli@latest build:list *)",
      "Bash(npx eas-cli@latest build:view *)",
      "Bash(npx eas-cli@latest env:list *)",
      "Bash(npx eas-cli@latest credentials *)",
      "Bash(fnm *)",
      "Bash(pnpm vitest *)",
      "Bash(pnpm --filter mimar test)",
      "Bash(pnpm --filter mimar test *)",
      "Bash(pnpm --filter mimar typecheck)",
      "Bash(pnpm --filter mimar exec jest *)",
      "Bash(pnpm --filter mimar exec expo config *)",
      "Bash(git fetch *)",
      "Bash(bat *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/biome-fix.mjs"
          }
        ]
      }
    ]
  }
}
