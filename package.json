{
  "name": "dim",
  "version": "0.1.0",
  "description": "MiMAR — Mi Mascota Argentina. Argentina's digital pet credential (internal codename: DIM).",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:tokens": "tsx scripts/check-design-tokens.ts",
    "verify": "pnpm typecheck && pnpm lint && pnpm lint:tokens && pnpm build",
    "format": "biome format --write .",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:reset": "supabase db reset",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:bootstrap": "tsx scripts/db-bootstrap.ts",
    "rls:smoke": "tsx scripts/rls-smoke.ts",
    "rebuild:projections": "tsx scripts/rebuild-projections.ts",
    "seed:test": "tsx scripts/seed-test-users.ts",
    "materialize:slots": "tsx scripts/materialize-slots.ts",
    "close:rabies-observations": "tsx scripts/close-rabies-observations.ts",
    "backfill:eno": "node --conditions=react-server --import tsx scripts/backfill-eno-trigger.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@supabase/ssr": "^0.5.0",
    "@supabase/supabase-js": "^2.45.0",
    "drizzle-orm": "^0.45.2",
    "maplibre-gl": "^5.24.0",
    "next": "^15.1.0",
    "pdf-lib": "^1.17.1",
    "postgres": "^3.4.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.8.1",
    "resend": "^6.12.3",
    "sharp": "^0.34.5",
    "sonner": "^2.0.7",
    "vaul": "^1.1.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.6",
    "csv-parse": "^6.2.1",
    "dotenv": "^16.4.0",
    "drizzle-kit": "^0.31.10",
    "postcss": "^8.5.0",
    "server-only": "^0.0.1",
    "supabase": "^2.0.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.22.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.6"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["@biomejs/biome", "esbuild", "sharp", "supabase"]
  }
}
